/* SIMB visual refresh — lapisan tambahan, seluruh perilaku lama dipertahankan. */
:root {
  --rd-bg: #fafafa;
  --rd-surface: #fff;
  --rd-ink: #101114;
  --rd-muted: #626873;
  --rd-line: #e7e8eb;
  --rd-accent: #c62828;
  --rd-accent-dark: #a51f1f;
  --rd-accent-soft: #fdecec;
  --rd-warn: #ef6c00;
  --rd-radius-lg: 24px;
  --rd-radius-md: 16px;
  --rd-pill: 999px;
  --rd-shadow: 0 8px 30px rgba(18, 24, 32, .055);
  --rd-shadow-hover: 0 16px 38px rgba(18, 24, 32, .11);
  --rd-container: 1180px;
  --rd-font: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
}

html { scroll-behavior: smooth; }
body { background: var(--rd-bg); color: var(--rd-ink); font-family: var(--rd-font); line-height: 1.6; }
::selection { background: #f7caca; color: #171717; }
a, button { -webkit-tap-highlight-color: transparent; }
a:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid #b3261e; outline-offset: 3px; }
section[id], #jarak { scroll-margin-top: 90px; }

/* Navbar bersama */
.navbar { background: rgba(13, 15, 18, .96) !important; border-bottom: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(14px); }
.navbar .container-xl { min-height: 68px; }
.navbar-brand { letter-spacing: -.045em; font-size: 1.3rem; }
.navbar .nav-link { color: rgba(255,255,255,.76); font-size: .9rem; padding: .65rem .85rem !important; border-radius: var(--rd-pill); transition: color .18s ease, background .18s ease; }
.navbar .nav-link:hover, .navbar .nav-link.active { color: #fff; background: rgba(255,255,255,.11); }
.navbar .btn-danger { border-radius: var(--rd-pill); padding: .65rem 1.15rem; background: var(--rd-accent); border-color: var(--rd-accent); }
.alert-bar { font-size: .92rem; font-weight: 600; border: 0; border-bottom: 1px solid rgba(0,0,0,.12); }
.alert-bar .container-xl { padding-top: .65rem !important; padding-bottom: .65rem !important; }

/* Hero */
.rd-main { overflow: clip; }
.rd-hero {
  position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: flex-end;
  min-height: 55vh; padding: clamp(3.5rem, 8vw, 7rem) max(24px, calc((100vw - var(--rd-container))/2));
  color: #fff; background: #25292c;
  background-image: linear-gradient(100deg, rgba(9,12,15,.82) 0%, rgba(9,12,15,.48) 55%, rgba(9,12,15,.25) 100%),
    radial-gradient(ellipse at 75% 20%, rgba(177,110,70,.42), transparent 42%),
    linear-gradient(145deg, #26363c 0%, #52636a 34%, #73533b 67%, #211e1b 100%);
  overflow: hidden;
}
.rd-hero::before, .rd-hero::after { content: ""; position: absolute; z-index: -1; pointer-events: none; }
.rd-hero::before { width: 62vw; height: 62vw; min-width: 560px; min-height: 560px; right: -9%; top: -56%; border-radius: 50%; border: 1px solid rgba(255,255,255,.13); box-shadow: 0 0 0 55px rgba(255,255,255,.025), 0 0 0 110px rgba(255,255,255,.02); }
.rd-hero::after { inset: auto 0 0; height: 45%; background: linear-gradient(0deg, rgba(0,0,0,.4), transparent); }
.rd-hero-inner { width: 100%; max-width: var(--rd-container); margin: 0 auto; padding-bottom: clamp(2rem, 6vw, 5rem); }
.rd-eyebrow { display: inline-flex; align-items: center; gap: .6rem; padding: .42rem .8rem; border: 1px solid rgba(255,255,255,.36); border-radius: var(--rd-pill); color: rgba(255,255,255,.9); font-size: .72rem; font-weight: 700; letter-spacing: .12em; }
.rd-live-dot { width: 8px; height: 8px; border-radius: 50%; background: #ff6b5f; box-shadow: 0 0 0 4px rgba(255,107,95,.18); }
.rd-hero h1 { margin: 1.35rem 0 .75rem; max-width: 850px; color: #fff; font-size: clamp(3.2rem, 9vw, 7rem); line-height: .94; letter-spacing: -.075em; font-weight: 650; }
.rd-hero h1 span { color: #ffd8d3; }
.rd-hero p { max-width: 570px; margin: 0; color: rgba(255,255,255,.88); font-size: clamp(1rem, 1.7vw, 1.2rem); }
.rd-hero-strip { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0; width: 100%; max-width: var(--rd-container); margin: 0 auto; border: 1px solid rgba(255,255,255,.22); border-radius: 18px; background: rgba(18,20,22,.48); backdrop-filter: blur(16px); overflow: hidden; }
.rd-hero-strip > a { display: flex; flex: 1 1 125px; flex-direction: column; justify-content: center; gap: .2rem; min-height: 68px; padding: .75rem 1rem; color: #fff; text-decoration: none; border-right: 1px solid rgba(255,255,255,.16); font-size: .82rem; font-weight: 600; transition: background .18s ease; }
.rd-hero-strip > a:hover { background: rgba(255,255,255,.12); }
.rd-hero-strip > a span { color: rgba(255,255,255,.62); font-size: .65rem; letter-spacing: .08em; }
.rd-hero-strip > .rd-hero-action { flex: 1.35 1 190px; flex-direction: row; align-items: center; justify-content: center; gap: .7rem; background: #fff; color: #111; border: 0; font-weight: 750; }
.rd-hero-strip > .rd-hero-action:hover { background: #f4e9e8; }

.rd-content { max-width: var(--rd-container); }
.kartu { background: var(--rd-surface); border: 1px solid var(--rd-line); border-radius: var(--rd-radius-lg); box-shadow: var(--rd-shadow); overflow: hidden; }
.kartu-judul { display: flex; align-items: center; gap: .5rem; min-height: 52px; padding: .9rem 1.25rem .55rem; border: 0; color: var(--rd-muted); font-size: .75rem; font-weight: 750; letter-spacing: .075em; text-transform: uppercase; }
.kartu-judul > i { color: var(--rd-accent) !important; font-size: .95rem; }
#detailTerbaru { padding: 1.2rem 1.35rem .7rem !important; }
#detailTerbaru .mag { min-width: 4.2rem; padding: .35rem .65rem; border-radius: 14px; font-size: 2rem; line-height: 1.25; }
#detailTerbaru strong { color: var(--rd-ink); }
#detailTerbaru ul { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .6rem 1rem; margin-top: 1.1rem !important; color: var(--rd-muted); }
#detailTerbaru ul li { padding: .65rem .75rem; border-radius: 12px; background: #f7f7f8; }
#statusData { padding: 0 1.35rem .9rem !important; }

/* Kontak darurat */
#kontak .p-3 { padding: 1rem 1.15rem 1.2rem !important; }
.btn-darurat { display: flex; flex-direction: column; justify-content: center; min-height: 76px; gap: .05rem; padding: .75rem 1rem; border: 0; border-radius: 17px; background: var(--rd-accent); color: #fff; text-align: left; font-size: .9rem; box-shadow: 0 5px 14px rgba(198,40,40,.15); transition: background .18s ease, transform .18s ease; }
.btn-darurat:hover, .btn-darurat:focus { background: var(--rd-accent-dark); color: #fff; transform: translateY(-2px); }
.btn-darurat .nomor { float: none; order: 2; font-size: 1.35rem; font-weight: 800; letter-spacing: -.035em; }
.btn-darurat small { order: 3; }

/* Akses cepat */
.akses-cepat { margin-top: 1.5rem !important; margin-bottom: 2.5rem !important; }
.akses-cepat a { display: block; height: 100%; }
.akses-cepat .kartu { position: relative; min-height: 172px; padding: 1.25rem !important; border-radius: 20px; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
.akses-cepat a:hover .kartu { transform: translateY(-4px); border-color: #e2b5b5; box-shadow: var(--rd-shadow-hover); }
.akses-cepat i { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; background: var(--rd-accent-soft); color: var(--rd-accent) !important; font-size: 1.2rem; }
.akses-cepat .fw-bold { margin-top: 1rem !important; font-size: 1rem; }
.akses-cepat .small { margin-top: .25rem; line-height: 1.45; }

/* Peta, jarak, notifikasi */
#peta .kartu-judul { flex-wrap: wrap; justify-content: space-between; padding: 1rem 1.25rem .65rem; }
#peta .kartu-judul > span:first-child { color: var(--rd-ink); font-size: .9rem; letter-spacing: 0; text-transform: none; }
#peta .kartu-judul > span:last-child { display: inline-flex; align-items: center; flex-wrap: wrap; gap: .25rem; padding: .4rem .65rem; border: 1px solid var(--rd-line); border-radius: var(--rd-pill); background: #fff; color: #454950; font-size: .68rem; }
.legend-dot { width: .62rem; height: .62rem; border: 0; margin-left: .35rem; }
#petaGempa { height: 460px; border: 0; border-radius: 16px; z-index: 0; }
#peta .p-2 { padding: .55rem !important; }
#jarak .p-3, #jarak + .kartu .p-3 { padding: 1rem 1.2rem 1.25rem !important; }
#btnLokasi { min-height: 50px; border: 0; border-radius: var(--rd-pill); background: #111318; font-weight: 700; }
#btnLokasi:hover { background: #343840; }
#hasilJarak { line-height: 1.6; }
.form-check-input { cursor: pointer; }
.form-check-input:checked { background-color: var(--rd-accent); border-color: var(--rd-accent); }
.form-check-label { cursor: pointer; }

/* Heading section */
#dirasakan, #daftar, #statistik, #edukasi { margin-top: 3.6rem !important; margin-bottom: 3.6rem !important; }
#dirasakan > h2, #daftar > h2, #statistik > h2, #edukasi > h2 { display: flex; align-items: center; gap: .65rem; margin-bottom: .75rem; padding: 0 0 1rem !important; border: 0 !important; color: var(--rd-ink); font-size: clamp(2rem, 5vw, 3.35rem); font-weight: 600 !important; letter-spacing: -.065em; line-height: 1.05; }
#dirasakan > h2 i, #daftar > h2 i, #statistik > h2 i, #edukasi > h2 i { color: var(--rd-accent) !important; font-size: 1.45rem; }
#dirasakan > p { max-width: 680px; margin-bottom: 1.5rem; color: var(--rd-muted) !important; font-size: .96rem !important; }
#listDirasakan .kartu { height: 100%; border-radius: 20px; transition: transform .18s ease, box-shadow .18s ease; }
#listDirasakan .kartu:hover { transform: translateY(-3px); box-shadow: var(--rd-shadow-hover); }
#listDirasakan .item-gempa { border-left: 4px solid var(--simb-info); }
#listDirasakan .item-gempa.level-bahaya { border-left-color: var(--rd-accent); }
#listDirasakan .item-gempa.level-waspada { border-left-color: var(--rd-warn); }
.mag { min-width: 3rem; padding: .25rem .55rem; border-radius: var(--rd-pill); font-size: .88rem; }
#listDirasakan .btn-link { margin-top: .45rem; color: var(--rd-accent); font-weight: 700; text-decoration: none; }

/* Tabel M5+ */
#daftar .table-responsive { border-radius: var(--rd-radius-lg); }
.tabel-gempa { min-width: 650px; margin: 0; }
.tabel-gempa thead th { padding: 1rem 1.1rem; border-bottom: 1px solid var(--rd-line); background: #fff; color: #747983; font-size: .69rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
.tabel-gempa tbody td { padding: .95rem 1.1rem; border-color: #f0f0f1; color: #41454d; font-size: .88rem; }
.tabel-gempa tbody tr { transition: background .15s ease; }
.tabel-gempa tbody tr:hover > * { background: #fff3f2; }
#daftar > .small { color: var(--rd-muted) !important; }

/* Statistik */
#statistik > .kartu { padding: 1.1rem 1.25rem !important; }
#formStat { flex: 1 1 360px; }
#formStat > div { min-width: 135px; flex: 1 1 135px; }
#formStat .form-label { color: var(--rd-muted); font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
#formStat .form-control { min-height: 40px; border: 0; border-bottom: 1px solid #d9dadd; border-radius: 0; background: transparent; box-shadow: none; }
#formStat .form-control:focus { border-bottom: 2px solid var(--rd-accent); }
#formStat button, .btn-preset { min-height: 38px; padding: .48rem 1rem; border-radius: var(--rd-pill); font-weight: 700; }
#formStat button { background: #111318; border-color: #111318; }
.btn-preset { border-color: #dfe0e3; color: #333740; }
.btn-preset:hover, .btn-preset.btn-dark { background: #111318; border-color: #111318; color: #fff; }
#statStatus { font-size: .78rem; }
#statRingkasan { row-gap: .75rem !important; }
#statRingkasan .kartu { height: 100%; padding: 1rem !important; border-radius: 18px; text-align: left !important; }
#statRingkasan .fs-3 { color: var(--rd-ink); font-size: 2.35rem !important; letter-spacing: -.06em; }
#statRingkasan .small { color: var(--rd-muted); }
#statGrafik .kartu { padding: 1.25rem !important; }
#statGrafik .fw-bold { margin-bottom: .9rem !important; font-size: .95rem; }
.kotak-grafik { position: relative; height: 280px; }
#statKosong { padding: 2.5rem !important; }
#statCatatan { color: var(--rd-muted) !important; line-height: 1.55; }

/* Edukasi */
#edukasi .row { counter-reset: rd-edu; }
#edukasi .row > div { counter-increment: rd-edu; }
#edukasi .row > div > a { display: block; height: 100%; }
#edukasi .kartu { position: relative; min-height: 150px; padding: 1.25rem !important; border-radius: 20px; transition: transform .18s ease, box-shadow .18s ease; }
#edukasi .row > div > a:hover .kartu { transform: translateY(-4px); box-shadow: var(--rd-shadow-hover); }
#edukasi .kartu::before { content: "0" counter(rd-edu); display: block; margin-bottom: 1rem; color: var(--rd-accent); font-size: .7rem; font-weight: 800; letter-spacing: .12em; }
#edukasi .kartu .fw-bold { margin-bottom: .35rem; font-size: 1.08rem; }
#edukasi .kartu .small { color: var(--rd-muted) !important; line-height: 1.5; }

/* Footer */
footer.bg-dark { margin-top: 5rem !important; padding: 3.2rem 0 !important; border-radius: 32px 32px 0 0; background: #111318 !important; }
footer .container-xl { max-width: var(--rd-container); }
footer strong { display: inline-block; margin-bottom: .55rem; color: #fff; font-size: .95rem; }
footer .small { color: rgba(255,255,255,.72); line-height: 1.8; }
footer a { text-underline-offset: 3px; }

@media (min-width: 992px) {
  .rd-hero { min-height: 55vh; }
  .akses-cepat > div:nth-child(2), .akses-cepat > div:nth-child(4) { transform: translateY(14px); }
  .akses-cepat > div:nth-child(2):hover, .akses-cepat > div:nth-child(4):hover { transform: translateY(10px); }
}
@media (max-width: 991.98px) {
  .rd-hero { min-height: 48vh; padding-top: 4rem; }
  .rd-hero-strip > a { flex-basis: 30%; }
  #kontak { margin-top: 0; }
}
@media (max-width: 767.98px) {
  .rd-hero { min-height: 45vh; padding: 3.25rem 1.1rem 1.1rem; }
  .rd-hero-inner { padding-bottom: 2rem; }
  .rd-hero h1 { font-size: clamp(3rem, 13vw, 5rem); }
  .rd-hero-strip { border-radius: 15px; }
  .rd-hero-strip > a { flex: 1 1 33.333%; min-height: 62px; padding: .65rem .7rem; font-size: .74rem; }
  .rd-hero-strip > .rd-hero-action { flex: 1 1 100%; min-height: 54px; }
  .rd-content { padding-top: 1.25rem !important; }
  #detailTerbaru ul { grid-template-columns: 1fr; }
  .akses-cepat .kartu { min-height: 160px; padding: 1rem !important; }
  #petaGempa { height: 360px; }
  #dirasakan, #daftar, #statistik, #edukasi { margin-top: 2.8rem !important; margin-bottom: 2.8rem !important; }
  #dirasakan > h2, #daftar > h2, #statistik > h2, #edukasi > h2 { font-size: clamp(1.9rem, 8vw, 2.6rem); }
  #formStat { flex-basis: 100%; }
  #formStat > div { flex-basis: calc(50% - .5rem); }
  #formStat button { width: 100%; }
  footer.bg-dark { border-radius: 24px 24px 0 0; }
}
@media (max-width: 575.98px) {
  .navbar .container-xl { padding-left: 1rem; padding-right: 1rem; }
  .rd-hero-strip > a { flex-basis: 50%; }
  .rd-hero-strip > a:nth-child(2n) { border-right: 0; }
  .rd-hero-strip > .rd-hero-action { flex-basis: 100%; }
  .kartu { border-radius: 19px; }
  #peta .kartu-judul > span:last-child { line-height: 1.8; }
  #statGrafik .kotak-grafik { height: 260px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
}
@media print {
  .rd-hero, .rd-hero-strip { display: none !important; }
  footer.bg-dark { border-radius: 0; }
}
